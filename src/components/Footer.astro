---
import { siteProfile } from '@/data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resumeHref = `${base}/${siteProfile.resumePath}`;
---

<footer class="site-footer">
  <div class="page-shell site-footer__bottom">
    <span>© 2026 SIM MINWOO · AI ENGINEER PORTFOLIO</span>
    <div class="site-footer__links">
      <a href={`mailto:${siteProfile.email}`}>{siteProfile.email}</a>
      <a href={`tel:${siteProfile.phone.replaceAll('-', '')}`}>{siteProfile.phone}</a>
      <a href={resumeHref} download>RESUME PDF</a>
      {siteProfile.github && <a href={siteProfile.github} rel="noreferrer">GITHUB</a>}
    </div>
  </div>
</footer>
