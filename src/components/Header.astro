---
import { siteProfile } from '@/data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}` || '/';
const path = Astro.url.pathname;
const navItems = [
  { label: '프로젝트', href: '/#projects' },
  { label: 'Workflow', href: '/#perspective' },
  { label: '경력', href: '/experience/' },
  { label: 'Profile', href: '/about/' }
];
---

<header class="site-header" data-site-header>
  <div class="site-header__inner page-shell">
    <a class="site-mark" href={href('/')} aria-label={`${siteProfile.name} 포트폴리오 홈`}>
      <span class="site-mark__name">{siteProfile.name}</span>
      <span class="site-mark__role">AI / ML 엔지니어</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-menu-toggle
    >
      <span>메뉴</span>
      <span class="menu-toggle__line" aria-hidden="true"></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label="주요 메뉴" data-navigation>
      {navItems.map((item) => (
        <a
          href={href(item.href)}
          aria-current={!item.href.includes('#') && path.includes(item.href.replaceAll('/', '')) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const navigation = document.querySelector('[data-navigation]');

  if (header && toggle && navigation) {
    const closeMenu = (returnFocus = false) => {
      toggle.setAttribute('aria-expanded', 'false');
      header.removeAttribute('data-menu-open');
      if (returnFocus) (toggle as HTMLElement).focus();
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
        return;
      }
      toggle.setAttribute('aria-expanded', 'true');
      header.setAttribute('data-menu-open', '');
      navigation.querySelector<HTMLElement>('a')?.focus();
    });

    navigation.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeMenu());
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') closeMenu(true);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 720) closeMenu();
    });
  }
</script>
