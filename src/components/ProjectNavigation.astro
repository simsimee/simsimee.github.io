---
import { projects } from '@/data/projects';

type Props = { currentSlug: string };
const { currentSlug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const index = projects.findIndex((project) => project.slug === currentSlug);
const previous = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
---

<nav class="project-navigation" aria-label="다른 프로젝트 보기">
  <a href={`${base}/projects/${previous.slug}/`}>
    <span>이전 프로젝트</span>
    <strong>{previous.shortTitle}</strong>
  </a>
  <a href={`${base}/projects/${next.slug}/`}>
    <span>다음 프로젝트</span>
    <strong>{next.shortTitle}</strong>
  </a>
</nav>
