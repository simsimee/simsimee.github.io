---
import BaseLayout from '@/layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="페이지를 찾을 수 없습니다 · 심민우 포트폴리오">
  <section class="not-found page-shell">
    <span>404</span>
    <h1>요청한 페이지를 찾을 수 없습니다.</h1>
    <p>주소가 변경되었거나 잘못 입력되었을 수 있습니다.</p>
    <a class="text-link" href={`${base}/`}>홈으로 돌아가기 <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
