---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DataPipeline from '@/components/DataPipeline.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import { projects } from '@/data/projects';
import { siteProfile } from '@/data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const assetHref = (path: string) => `${base}${path}`;
const featuredProjects = projects.slice(0, 3);
const otherProjects = projects.slice(3);
---

<BaseLayout>
  <section class="hero page-shell">
    <div class="hero__identity">
      <p class="hero__eyebrow">{siteProfile.positioning}</p>
      <h1>
        데이터 전략으로<br />
        <span>모델 성능과 생산성 개선</span>
      </h1>
    </div>
    <div class="hero__statement">
      <p>
        AI/ML 실무 4년+.<br />
        Data Selection·Synthetic Data·Quality Control을 통한 성능과 생산 효율 개선.
      </p>
      <div class="hero__actions">
        <a class="text-link" href="#projects">프로젝트 살펴보기 <span aria-hidden="true">↘</span></a>
        <a class="text-link" href={href('/about/')}>소개와 기술 보기 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <dl class="hero__metrics" aria-label="대표 성과">
      <div>
        <dt>Dataset Efficiency</dt>
        <dd>−40%</dd>
        <small>mAP 0.64 → 0.85</small>
      </div>
      <div>
        <dt>Detection Performance</dt>
        <dd>+8.81</dd>
        <small>합성 증강 적용 · 최대 mAP points</small>
      </div>
      <div>
        <dt>OCR Latency</dt>
        <dd>0.07초</dd>
        <small>평균 추론 시간</small>
      </div>
    </dl>
  </section>

  <section id="perspective" class="page-section page-shell perspective-section perspective-section--compact">
    <SectionHeading
      index="01"
      label="Data-Centric Workflow"
      title="데이터 문제를 다루는 네 단계"
      description="단계 선택 시 관련 프로젝트와 담당 범위 표시."
    />
    <DataPipeline />
  </section>

  <section id="projects" class="page-section page-shell projects-section">
    <SectionHeading
      index="02"
      label="Selected Projects"
      title="대표 프로젝트 세 가지"
      description="핵심 결과, 실제 산출물, 담당 범위 중심의 요약."
    />

    <div class="project-ledger">
      {featuredProjects.map((project) => {
        const featuredArtifact = project.artifacts?.find((artifact) => artifact.featured);
        const selectedApproach = project.alternatives.find((alternative) => alternative.selected)?.name;
        return (
          <article class:list={['project-entry', `project-entry--${project.slug}`]}>
            <div class="project-entry__meta">
              <span>{String(project.order).padStart(2, '0')}</span>
              <p>{project.category}</p>
              <small>{project.period}</small>
            </div>
            <div class="project-entry__body">
              <p class="project-entry__impact">{project.resultLine}</p>
              <h3>{project.title}</h3>
              <dl class="project-entry__snapshot project-entry__snapshot--compact">
                <div><dt>문제</dt><dd>{project.dataProblem.title}</dd></div>
                <div><dt>핵심 결정</dt><dd>{selectedApproach}</dd></div>
                <div><dt>담당 범위</dt><dd>{project.role}</dd></div>
              </dl>
              <div class="project-entry__metrics">
                {project.metrics.slice(0, 2).map((metric) => (
                  <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
                ))}
              </div>
              <div class="project-entry__footer">
                <p><span>주요 기술</span>{project.stacks.slice(0, 4).join(' · ')}</p>
                <a
                  class="project-link"
                  href={href(`/projects/${project.slug}/`)}
                  aria-label={`${project.shortTitle} 프로젝트 상세 보기`}
                >
                  프로젝트 상세 보기 <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
            {featuredArtifact ? (
              <figure class="project-evidence-preview">
                <img
                  src={assetHref(featuredArtifact.src)}
                  alt={featuredArtifact.alt}
                  width={featuredArtifact.width}
                  height={featuredArtifact.height}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  <strong>실제 산출물</strong>
                  <span>{featuredArtifact.title}</span>
                </figcaption>
              </figure>
            ) : <ProjectVisual project={project} />}
          </article>
        );
      })}
    </div>
  </section>

  <section class="page-section page-shell other-projects-section">
    <SectionHeading
      index="03"
      label="Other Work"
      title="생성 파이프라인과 품질 자동화"
      description="상세 구현과 한계는 각 프로젝트 페이지에서 확인."
    />
    <div class="other-projects">
      {otherProjects.map((project) => (
        <article>
          <div>
            <span>{String(project.order).padStart(2, '0')}</span>
            <p>{project.category}</p>
          </div>
          <h3>{project.title}</h3>
          <p>{project.resultLine}</p>
          <a href={href(`/projects/${project.slug}/`)} aria-label={`${project.shortTitle} 프로젝트 상세 보기`}>
            상세 보기 <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section home-experience">
    <div class="page-shell">
      <p>AI/ML 실무 4년+ · Data Selection · Document AI · Synthetic Data · Generative CV</p>
      <a class="text-link" href={href('/experience/')}>전체 경력 보기 <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
