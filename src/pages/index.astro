---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DataPipeline from '@/components/DataPipeline.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import { projects } from '@/data/projects';
import { siteProfile, workingPrinciples } from '@/data/site';
import { compactCopy } from '@/utils/copy';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const careerMoments = [
  { year: '2022', title: 'Data Selection', detail: 'ODD · Active Learning · Dataset Optimization' },
  { year: '2024', title: 'Synthetic Data', detail: '한글 손글씨 생성 · OCR 학습·평가' },
  { year: '2025', title: 'Distribution Modeling', detail: 'Document Layout Prior · Synthetic Augmentation' },
  { year: '2026', title: 'Production Pipeline', detail: 'Image-to-3D · Quality Gate · Batch Automation' }
];
---

<BaseLayout>
  <section class="hero page-shell">
    <div class="hero__identity">
      <p class="hero__eyebrow">{siteProfile.positioning}</p>
      <h1>
        데이터 전략으로<br />
        <span>모델 성능과 생산성 개선</span>
      </h1>
    </div>
    <div class="hero__statement">
      <p>
        Data Selection · Synthetic Data · Quality Control.<br />
        모델 성능과 데이터 생산 비용을 함께 개선한 프로젝트 중심 포트폴리오.
      </p>
      <div class="hero__actions">
        <a class="text-link" href="#projects">프로젝트 살펴보기 <span aria-hidden="true">↘</span></a>
        <a class="text-link" href={href('/about/')}>소개와 기술 보기 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <dl class="hero__metrics" aria-label="대표 성과">
      <div>
        <dt>Dataset Efficiency</dt>
        <dd>−40%</dd>
        <small>mAP 0.64 → 0.85</small>
      </div>
      <div>
        <dt>Detection Performance</dt>
        <dd>+8.81</dd>
        <small>합성 증강 적용 · 최대 mAP points</small>
      </div>
      <div>
        <dt>OCR Latency</dt>
        <dd>0.07초</dd>
        <small>평균 추론 시간</small>
      </div>
    </dl>
  </section>

  <section id="projects" class="page-section page-shell projects-section">
    <SectionHeading
      index="01"
      label="Selected Projects"
      title="성과로 먼저 보는 프로젝트"
      description="Impact를 먼저 확인하고 Problem · Approach · Implementation · Evidence 순서로 상세 내용 확인."
    />

    <div class="project-ledger">
      {projects.map((project) => (
        <article class:list={['project-entry', `project-entry--${project.slug}`]}>
          <div class="project-entry__meta">
            <span>{String(project.order).padStart(2, '0')}</span>
            <p>{project.category}</p>
            <small>{project.period}</small>
          </div>
          <div class="project-entry__body">
            <p class="project-entry__impact">{project.resultLine}</p>
            <h3>{project.title}</h3>
            <p class="project-entry__intro">{compactCopy(project.intro)}</p>
            <dl class="project-entry__snapshot">
              <div><dt>Problem</dt><dd>{compactCopy(project.dataProblem.title)}</dd></div>
              <div><dt>My Work</dt><dd>{project.role}</dd></div>
            </dl>
            <div class="project-entry__metrics">
              {project.metrics.slice(0, 2).map((metric) => (
                <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
              ))}
            </div>
            <div class="project-entry__footer">
              <p><span>Stack</span>{project.stacks.slice(0, 4).join(' · ')}</p>
              <a
                class="project-link"
                href={href(`/projects/${project.slug}/`)}
                aria-label={`${project.shortTitle} 프로젝트 상세 보기`}
              >
                프로젝트 상세 보기 <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
          <ProjectVisual project={project} />
        </article>
      ))}
    </div>
  </section>

  <section id="perspective" class="page-section page-shell perspective-section">
    <SectionHeading
      index="02"
      label="Data-Centric Workflow"
      title="프로젝트를 연결하는 문제 해결 구조"
      description="전체 pipeline은 탐색 지도. 각 단계에서 관련 프로젝트와 담당 범위를 바로 확인."
    />
    <DataPipeline />
  </section>

  <section class="page-section career-flow">
    <div class="page-shell">
      <SectionHeading
        index="03"
        label="Career Progression"
        title="Data Selection에서 Production Pipeline으로"
        description="도메인보다 문제 해결 범위의 확장에 초점을 둔 경력 요약."
      />
      <ol class="career-flow__list">
        {careerMoments.map((moment) => (
          <li>
            <span>{moment.year}</span>
            <div>
              <strong>{moment.title}</strong>
              <p>{moment.detail}</p>
            </div>
          </li>
        ))}
      </ol>
      <a class="text-link career-flow__link" href={href('/experience/')}>
        전체 경력과 활동 보기 <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="page-section page-shell principles-section">
    <SectionHeading
      index="04"
      label="Working Principles"
      title="결과보다 먼저 확인하는 판단 기준"
      description="프로젝트 전반에 반복 적용한 설계·검증 원칙."
    />
    <ol class="principle-list">
      {workingPrinciples.map((principle, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{principle}</p>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
