---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import ProjectStageMap from '@/components/ProjectStageMap.astro';
import ProjectNavigation from '@/components/ProjectNavigation.astro';
import ProjectEvidence from '@/components/ProjectEvidence.astro';
import { projects, type Project } from '@/data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

type Props = { project: Project };
const { project } = Astro.props;
const hasArtifacts = Boolean(project.artifacts?.length);
const sectionNumber = (number: number) =>
  String(number + 1 + (hasArtifacts && number > 0 ? 1 : 0)).padStart(2, '0');
---

<BaseLayout
  title={`${project.shortTitle} · 심민우 포트폴리오`}
  description={project.intro}
  eyebrow={project.category}
>
  <article class:list={['case-study', `case-study--${project.slug}`]}>
    <header class="case-hero page-shell">
      <div class="case-hero__index">
        <span>프로젝트 {String(project.order).padStart(2, '0')}</span>
        <p>{project.category}</p>
      </div>
      <div class="case-hero__title">
        <h1>{project.title}</h1>
        <p>{project.intro}</p>
      </div>
      <p class="case-hero__impact"><span>핵심 결과</span>{project.resultLine}</p>
      <div class="case-metric-grid case-metric-grid--hero">
        {project.metrics.map((metric) => (
          <div class="case-metric">
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
            <p>{metric.context}</p>
          </div>
        ))}
      </div>
      <dl class="case-hero__facts">
        <div><dt>기간</dt><dd>{project.period}</dd></div>
        <div><dt>담당 범위</dt><dd>{project.role}</dd></div>
        <div><dt>주요 기술</dt><dd>{project.stacks.slice(0, 5).join(' · ')}</dd></div>
      </dl>
      <ProjectStageMap active={project.stages} />
    </header>

    <nav class="case-local-nav" aria-label="프로젝트 페이지 목차">
      <div class="page-shell">
        <a href="#overview">핵심 요약</a>
        {hasArtifacts && <a href="#artifacts">실제 산출물</a>}
        <a href="#problem">문제 정의</a>
        <a href="#approach">해결 접근</a>
        <a href="#implementation">구현</a>
        <a href="#results">결과</a>
        <a href="#reflection">한계</a>
      </div>
    </nav>

    <section id="overview" class="case-section page-shell case-overview">
      <div class="case-section__head">
        <span>{sectionNumber(0)}</span>
        <div><p>핵심 요약</p><h2>프로젝트 개요</h2></div>
      </div>
      <dl class="overview-brief">
        <div><dt>문제</dt><dd>{project.dataProblem.title}</dd></div>
        <div><dt>선택한 방법</dt><dd>{project.alternatives.filter((item) => item.selected).map((item) => item.name).join(' · ')}</dd></div>
        <div><dt>담당 범위</dt><dd>{project.role}</dd></div>
      </dl>
      <div class="overview-visual">
        <ProjectVisual project={project} />
      </div>
      <div class="stack-line">
        <span>사용 기술</span>
        <ul>{project.stacks.map((stack) => <li>{stack}</li>)}</ul>
      </div>
    </section>

    {hasArtifacts && (
      <section id="artifacts" class="case-section case-section--artifacts">
        <div class="page-shell">
          <div class="case-section__head">
            <span>02</span>
            <div><p>실제 산출물</p><h2>결과 화면과 작업 근거</h2></div>
          </div>
          <p class="artifact-intro">프로젝트 문서에서 공개 가능한 결과 화면만 선별. 이미지를 선택하면 원본 크기로 확인 가능.</p>
          <ProjectEvidence artifacts={project.artifacts!} />
        </div>
      </section>
    )}

    <section id="problem" class="case-section page-shell">
      <div class="case-section__head">
        <span>{sectionNumber(1)}</span>
        <div><p>문제 정의</p><h2>성능 저하의 원인</h2></div>
      </div>
      <div class="editorial-columns">
        <div class="serif-statement">
          <p>{project.dataProblem.title}</p>
        </div>
        <ul class="context-list">{project.context.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="data-diagnosis">
        <div>
          <p class="micro-label">데이터 진단</p>
          <h3>{project.dataProblem.title}</h3>
          <p>{project.dataProblem.description}</p>
        </div>
        <ul>
          {project.dataProblem.signals.map((signal) => <li>{signal}</li>)}
        </ul>
      </div>
    </section>

    <section id="approach" class="case-section case-section--tinted">
      <div class="page-shell">
        <div class="case-section__head">
          <span>{sectionNumber(2)}</span>
          <div><p>해결 접근</p><h2>대안 비교와 선택 근거</h2></div>
        </div>
        <div class="alternative-table" role="table" aria-label="검토한 접근 방법">
          {project.alternatives.map((alternative) => (
            <div class:list={['alternative-table__row', { 'is-selected': alternative.selected }]} role="row">
              <strong role="cell">{alternative.name}</strong>
              <p role="cell">{alternative.limitation}</p>
              <span role="cell">{alternative.selected ? '선택' : '검토'}</span>
            </div>
          ))}
        </div>
        <div class="project-pipeline">
          <p class="micro-label">프로젝트 파이프라인</p>
          <ol>
            {project.pipeline.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{step.title}</strong>
                <p>{step.detail}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section id="implementation" class="case-section page-shell">
      <div class="case-section__head">
        <span>{sectionNumber(3)}</span>
        <div><p>구현</p><h2>핵심 설계 결정과 담당 범위</h2></div>
      </div>
      <div class="decision-list">
        {project.decisions.map((decision) => (
          <article class="decision-item">
            <header><span>{decision.number}</span><h3>{decision.title}</h3></header>
            <div class="decision-item__grid">
              <div><b>문제</b><p>{decision.problem}</p></div>
              <div><b>결정</b><p>{decision.solution}</p></div>
              <div><b>변화</b><p>{decision.effect}</p></div>
            </div>
          </article>
        ))}
      </div>
      <div class="contribution-grid">
        <div>
          <p class="micro-label">직접 구현</p>
          <ul>{project.contributions.direct.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <p class="micro-label">활용한 기존 기술</p>
          <ul>{project.contributions.reused.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <p class="micro-label">협업 범위</p>
          <ul>{project.contributions.collaboration.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </section>

    <section id="results" class="case-section case-section--ink">
      <div class="page-shell">
        <div class="case-section__head">
          <span>{sectionNumber(4)}</span>
          <div><p>결과</p><h2>실험 조건과 확인된 결과</h2></div>
        </div>
        <div class="evidence-grid">
          <div>
            <p class="micro-label">실험 구성</p>
            <ol>{project.experiment.map((item) => <li>{item}</li>)}</ol>
          </div>
          <div>
            <p class="micro-label">확인된 결과</p>
            <ol>{project.findings.map((item) => <li>{item}</li>)}</ol>
          </div>
        </div>
      </div>
    </section>

    <section id="reflection" class="case-section page-shell">
      <div class="case-section__head">
        <span>{sectionNumber(5)}</span>
        <div><p>한계</p><h2>한계와 다음 검증 항목</h2></div>
      </div>
      <div class="reflection-grid">
        <div>
          <p class="micro-label">현재 한계</p>
          <ul>{project.limitations.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <p class="micro-label">다음 검증</p>
          <ul>{project.nextSteps.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
      <p class="honesty-note">측정한 결과와 확인하지 못한 효과를 구분해 기록.</p>
    </section>

    <div class="page-shell">
      <ProjectNavigation currentSlug={project.slug} />
    </div>
  </article>
</BaseLayout>
