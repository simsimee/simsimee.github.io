---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { siteProfile } from '@/data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const profileImage = `${base}/images/profile.webp`;
const skillGroups = [
  ['Computer Vision Models', ['YOLOv5', 'YOLOv13', 'RF-DETR', 'TrOCR', 'VisionEncoderDecoder']],
  ['Generative Vision', ['TRELLIS', 'Diffusers', 'Image-to-3D', 'LDM', 'Synthetic Data']],
  ['Multimodal & Representation', ['CLIP', 'Gemini', 'ResNet Embedding', 'VLM Quality Review']],
  ['Training & Evaluation', ['PyTorch', 'Hugging Face', 'OpenCV', 'mAP@50:95', 'Accuracy', 'CER', 'CUDA', 'Docker']]
];
---

<BaseLayout title="소개 · 심민우 포트폴리오" description={siteProfile.description}>
  <header class="subpage-hero page-shell about-hero">
    <div class="about-hero__copy">
      <p class="subpage-hero__eyebrow">Profile</p>
      <h1>Computer Vision 모델을<br />Data-Centric 방식으로 개선</h1>
      <p class="about-hero__summary">모델 선택·학습과 데이터 선별·생성·평가를 하나의 개선 루프로 설계.</p>
    </div>
    <figure class="about-hero__portrait">
      <img
        src={profileImage}
        alt="AI/ML 엔지니어 심민우 프로필 사진"
        width="1122"
        height="1402"
        decoding="async"
        fetchpriority="high"
      />
      <figcaption>
        <strong>심민우</strong>
        <span>{siteProfile.role}</span>
        <small>Object Detection · Generative Vision</small>
      </figcaption>
    </figure>
  </header>

  <section class="page-section page-shell about-statement">
    <SectionHeading index="01" label="How I Work" title="모델과 데이터를 함께 개선하는 방식" />
    <div class="editorial-columns">
      <p class="serif-statement">Task·Metric 정의. Model Architecture 선택. Failure Case 기반 데이터 개선.</p>
      <ul class="context-list">
        <li>Object Detection: YOLOv5·13·RF-DETR 학습과 Cross-model Evaluation</li>
        <li>OCR: TrOCR Fine-tuning·Tokenizer 개조·CER 기반 오류 분석</li>
        <li>Generative Vision: TRELLIS·Diffusion 모델을 연결한 3D 합성 파이프라인</li>
        <li>Multimodal AI: CLIP·Gemini 기반 품질 평가와 자동 검수</li>
      </ul>
    </div>
  </section>

  <section class="page-section page-shell skills-section">
    <SectionHeading index="02" label="Capabilities" title="모델 태스크별 기술" />
    <div class="skill-groups">
      {skillGroups.map(([title, skills]) => (
        <div class="skill-group">
          <h2>{title}</h2>
          <ul>{(skills as string[]).map((skill) => <li>{skill}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="page-section page-shell contact-section">
    <SectionHeading index="03" label="Contact" title="연락처" />
    <div class="contact-layout">
      <ul>
        <li>Object Detection·Computer Vision 모델 개발</li>
        <li>Document AI·OCR·Vision-Language 모델 활용</li>
        <li>Generative Vision·Multimodal 품질 평가</li>
      </ul>
      <div>
        <a href={`mailto:${siteProfile.email}`}>{siteProfile.email}</a>
        <a href={`${base}/${siteProfile.resumePath}`} download>이력서 PDF 내려받기</a>
      </div>
    </div>
  </section>
</BaseLayout>
