---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { siteProfile } from '@/data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const skillGroups = [
  ['데이터 진단·선별', ['Active Learning', 'Uncertainty Sampling', 'ODD', 'FP/FN Analysis', 'FAISS', 'FiftyOne']],
  ['합성·증강', ['Synthetic Data', 'KDE Layout Modeling', 'TrOCR', 'TRELLIS', 'Diffusion', 'Augraphy']],
  ['평가·품질', ['mAP@50:95', 'CER', 'Confidence Analysis', 'CLIP Gate', 'LLM-as-a-Judge']],
  ['엔지니어링', ['Python', 'PyTorch', 'Hugging Face', 'OpenCV', 'Docker', 'CUDA', 'Pydantic']]
];
---

<BaseLayout title="소개 · 심민우 포트폴리오" description={siteProfile.description}>
  <header class="subpage-hero page-shell about-hero">
    <p class="subpage-hero__eyebrow">Profile</p>
    <h1>Data-Centric 관점으로<br />모델 성능과 생산성을 개선</h1>
    <p>Data Selection · Synthetic Data · Evaluation · Production Pipeline</p>
  </header>

  <section class="page-section page-shell about-statement">
    <SectionHeading index="01" label="How I Work" title="데이터 문제를 실행 가능한 설계로 전환" />
    <div class="editorial-columns">
      <p class="serif-statement">모델 변경 전, Failure Case와 데이터 분포 우선 확인.</p>
      <ul class="context-list">
        <li>자율주행: ODD와 Active Learning 기반 학습 샘플 선별</li>
        <li>OCR: 부족한 실사용 데이터를 Synthetic Data로 보완</li>
        <li>Document AI: 도메인별 Layout Distribution 직접 모델링</li>
        <li>Generative CV: 수집하기 어려운 시점·장면 생성과 Quality Gate 설계</li>
      </ul>
    </div>
  </section>

  <section class="page-section page-shell skills-section">
    <SectionHeading index="02" label="Capabilities" title="문제 해결 단계별 기술" />
    <div class="skill-groups">
      {skillGroups.map(([title, skills]) => (
        <div class="skill-group">
          <h2>{title}</h2>
          <ul>{(skills as string[]).map((skill) => <li>{skill}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="page-section page-shell contact-section">
    <SectionHeading index="03" label="Contact" title="연락처" />
    <div class="contact-layout">
      <ul>
        <li>저자원 환경의 데이터 전략과 합성 데이터</li>
        <li>문서 AI·OCR·컴퓨터 비전</li>
        <li>생성 모델 품질 평가와 자동화 파이프라인</li>
      </ul>
      <div>
        <a href={`mailto:${siteProfile.email}`}>{siteProfile.email}</a>
        <a href={`${base}/${siteProfile.resumePath}`} download>이력서 PDF 내려받기</a>
      </div>
    </div>
  </section>
</BaseLayout>
